# AI Oncall Agent Configuration

# Service
DEBUG=false
HOST=0.0.0.0
PORT=8001

# LLM Provider: qianfan, openai, openrouter, ollama, mock
LLM_PROVIDER=openrouter

# 百度千帆配置
QIANFAN_AK=your_qianfan_ak
QIANFAN_SK=your_qianfan_sk
QIANFAN_MODEL=ernie-4.0-8k

# OpenAI / OpenRouter 配置
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Ollama 配置 (可选)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# Timeouts (seconds)
LLM_TIMEOUT=60
HTTP_TIMEOUT=30
